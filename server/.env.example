# ---------- 服务端环境变量示例 ----------
# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，禁止提交

# PostgreSQL 连接串
DATABASE_URL=postgresql://app_user:<你的数据库密码>@127.0.0.1:5432/gi_edu

# JWT 签名密钥：请使用足够随机的长字符串，勿使用示例值
JWT_SECRET=<请替换为随机字符串>

# 腾讯云对象存储（视频托管，可选）
COS_SECRET_ID=<你的 SecretId>
COS_SECRET_KEY=<你的 SecretKey>
COS_BUCKET=<存储桶名称>
COS_REGION=<存储桶所在地域>
COS_VIDEO_PREFIX=videos/

# 允许跨域的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
